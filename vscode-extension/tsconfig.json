{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here for src/webview/**, which runs inside the webview's own
    // page rather than the extension host - everywhere else in src/ is
    // Node, and none of it happens to name anything DOM redefines
    // incompatibly, so one shared lib list covers both runtimes safely.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "sourceMap": true,
    "outDir": "dist",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
