{
  "name": "llmhell-knowledge-base",
  "displayName": "Coder (knowledge-base backed)",
  "description": "A coding agent in the editor, backed by the team's knowledge base and your own MCP servers.",
  "version": "0.1.0",
  "private": true,
  "publisher": "llmhell",
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "Knowledge Base",
      "properties": {
        "knowledgeBase.baseUrl": {
          "type": "string",
          "default": "https://llmhell.borzo.ai",
          "markdownDescription": "Origin of the knowledge-base API. The backend, not the web app — point this at a local backend (`http://localhost:8000`) to develop against one."
        },
        "knowledgeBase.username": {
          "type": "string",
          "default": "",
          "description": "Account to sign in as. The password is never stored here; run \"Knowledge Base: Sign In\" and it goes into the editor's secret storage."
        },
        "knowledgeBase.coder.confirmTools": {
          "type": "boolean",
          "default": true,
          "description": "Ask before @coder writes files or runs terminal commands."
        },
        "knowledgeBase.coder.maxAgentTurns": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum tool rounds for the coding agent."
        },
        "knowledgeBase.mcp.servers": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "description": "A local server: spawned as `command args...`, spoken to over MCP's stdio transport."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "url": {
                "type": "string",
                "description": "A remote server: spoken to over MCP's streamable-HTTP transport. Set this instead of `command`, not alongside it."
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "disabled": {
                "type": "boolean",
                "default": false
              }
            }
          },
          "markdownDescription": "Custom MCP servers `@coder` can call as tools, keyed by name - the same shape most MCP clients use, so an entry from Claude Desktop's or Cursor's config drops in unedited. Use \"Knowledge Base: Manage MCP Servers\" for a guided add/remove instead of editing this directly."
        },
        "knowledgeBase.coder.mode": {
          "type": "string",
          "enum": [
            "manual",
            "assisted",
            "autonomous"
          ],
          "default": "manual",
          "markdownEnumDescriptions": [
            "Ask before writing a file and before running a command.",
            "Write files in the workspace without asking; still ask before running a command.",
            "Ask about nothing. File paths outside the workspace are still refused."
          ],
          "description": "Tool approval policy for the coding agent."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "knowledgeBase",
          "title": "Knowledge Base",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "knowledgeBase": [
        {
          "id": "knowledgeBase.chat",
          "name": "Chat",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "knowledgeBase.chat",
        "when": "!knowledgeBase.signedIn",
        "contents": "The coder needs an account on the backend.\n[Sign in](command:knowledgeBase.signIn)\n\n[Open settings](command:workbench.action.openSettings?%22knowledgeBase%22)"
      }
    ],
    "commands": [
      {
        "command": "knowledgeBase.openCustomChat",
        "title": "Open Chat",
        "category": "Knowledge Base",
        "icon": "$(layout-panel)"
      },
      {
        "command": "knowledgeBase.newChat",
        "title": "New Chat",
        "category": "Knowledge Base",
        "icon": "$(add)"
      },
      {
        "command": "knowledgeBase.chatHistory",
        "title": "Earlier Conversations",
        "category": "Knowledge Base",
        "icon": "$(history)"
      },
      {
        "command": "knowledgeBase.openCoderChat",
        "title": "Ask Coder",
        "category": "Knowledge Base",
        "icon": "$(code)"
      },
      {
        "command": "knowledgeBase.signIn",
        "title": "Sign In",
        "category": "Knowledge Base"
      },
      {
        "command": "knowledgeBase.signOut",
        "title": "Sign Out",
        "category": "Knowledge Base"
      },
      {
        "command": "knowledgeBase.accounts",
        "title": "Connect Accounts (Google, GitLab)",
        "category": "Knowledge Base",
        "icon": "$(key)"
      },
      {
        "command": "knowledgeBase.mcp.manage",
        "title": "Manage MCP Servers",
        "category": "Knowledge Base",
        "icon": "$(plug)"
      },
      {
        "command": "knowledgeBase.mcp.reload",
        "title": "Reload MCP Servers",
        "category": "Knowledge Base"
      },
      {
        "command": "knowledgeBase.mcp.showLog",
        "title": "Show MCP Log",
        "category": "Knowledge Base"
      },
      {
        "command": "knowledgeBase.askSelection",
        "title": "Ask the Coder about the Selection",
        "category": "Knowledge Base"
      },
      {
        "command": "knowledgeBase.setBackendUrl",
        "title": "Set Backend URL",
        "category": "Knowledge Base",
        "icon": "$(server-environment)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "knowledgeBase.newChat",
          "when": "view == knowledgeBase.chat",
          "group": "navigation@0"
        },
        {
          "command": "knowledgeBase.chatHistory",
          "when": "view == knowledgeBase.chat",
          "group": "navigation@1"
        },
        {
          "command": "knowledgeBase.accounts",
          "when": "view == knowledgeBase.chat",
          "group": "navigation@2"
        },
        {
          "command": "knowledgeBase.mcp.manage",
          "when": "view == knowledgeBase.chat",
          "group": "navigation@3"
        },
        {
          "command": "knowledgeBase.setBackendUrl",
          "when": "view == knowledgeBase.chat",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "knowledgeBase.askSelection",
          "when": "editorHasSelection",
          "group": "navigation@9"
        }
      ]
    },
    "keybindings": [
      {
        "command": "knowledgeBase.openCoderChat",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c"
      },
      {
        "command": "knowledgeBase.askSelection",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      }
    ],
    "chatParticipants": [
      {
        "id": "knowledgeBase.coder",
        "name": "coder",
        "fullName": "Coder",
        "description": "Coding assistant backed by the knowledge base",
        "isSticky": true
      }
    ]
  },
  "scripts": {
    "build:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20",
    "build:webview": "esbuild src/webview/main.ts --bundle --outfile=dist/webview.js --format=iife --platform=browser --target=es2022",
    "build": "pnpm run build:extension && pnpm run build:webview",
    "watch": "pnpm run build:extension --sourcemap --watch",
    "watch:webview": "pnpm run build:webview --sourcemap --watch",
    "package": "pnpm run build:extension --minify && pnpm run build:webview --minify",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/node": "^20",
    "@types/vscode": "^1.104.0",
    "esbuild": "^0.25.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.15.1"
}
