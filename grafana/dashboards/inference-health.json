{
  "uid": "llmhell-inference-health",
  "title": "Inference health",
  "tags": ["llmhell"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Time to first token (p50/p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum(rate(llm_ttft_seconds_bucket[5m])) by (le, model, role))",
          "legendFormat": "p50 {{model}} ({{role}})"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(llm_ttft_seconds_bucket[5m])) by (le, model, role))",
          "legendFormat": "p95 {{model}} ({{role}})"
        }
      ]
    },
    {
      "id": 2,
      "title": "Output tokens/sec (p50)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum(rate(llm_output_tps_bucket[5m])) by (le, model, role))",
          "legendFormat": "{{model}} ({{role}})"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(llm_request_duration_seconds_bucket[5m])) by (le, model, role))",
          "legendFormat": "{{model}} ({{role}})"
        }
      ]
    },
    {
      "id": 4,
      "title": "LLM errors/sec by type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(llm_errors_total[5m])) by (model, type)",
          "legendFormat": "{{model}} - {{type}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Requests/min",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(llm_request_duration_seconds_count[5m])) * 60"
        }
      ]
    },
    {
      "id": 6,
      "title": "Error rate (5m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(rate(llm_errors_total[5m])) / clamp_min(sum(rate(llm_request_duration_seconds_count[5m])), 1e-9)"
        }
      ]
    },
    {
      "id": 8,
      "title": "vLLM queue depth (RunPod endpoints)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Populated once real RunPod vLLM endpoints are added as scrape targets in prometheus/prometheus.yml (empty against mock-vllm, which exposes no /metrics).",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "vllm:num_requests_waiting"
        }
      ]
    },
    {
      "id": 9,
      "title": "vLLM KV-cache utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Populated once real RunPod vLLM endpoints are added as scrape targets in prometheus/prometheus.yml (empty against mock-vllm, which exposes no /metrics).",
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "vllm:gpu_cache_usage_perc"
        }
      ]
    }
  ]
}
