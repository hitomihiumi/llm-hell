{
  "uid": "llmhell-inference-health",
  "title": "Inference health",
  "tags": ["llmhell"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Time to first token (p50/p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum(rate(llm_ttft_seconds_bucket[$__rate_interval])) by (le, model, role))",
          "legendFormat": "p50 {{model}} ({{role}})"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(llm_ttft_seconds_bucket[$__rate_interval])) by (le, model, role))",
          "legendFormat": "p95 {{model}} ({{role}})"
        }
      ]
    },
    {
      "id": 2,
      "title": "Output throughput (tokens/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Counter rate, deliberately NOT histogram_quantile(llm_output_tps) as before. That query broke the line into gaps and lagged badly: llm_output_tps is only observed when a request FINISHES, so a window with no completions makes every bucket's rate 0, histogram_quantile returns NaN, and Grafana draws a hole - while a long streaming request contributes nothing at all until it ends. A counter rate is 0 (not NaN) when idle, so the line stays continuous, and vLLM's own counter below ticks up during generation instead of only at the end.",
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "spanNulls": true } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(llm_tokens_total{kind=\"completion\"}[$__rate_interval])) by (model)",
          "legendFormat": "{{model}} (measured by proxy)"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(vllm:generation_tokens_total[$__rate_interval]))",
          "legendFormat": "vLLM engine"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(llm_request_duration_seconds_bucket[$__rate_interval])) by (le, model, role))",
          "legendFormat": "{{model}} ({{role}})"
        }
      ]
    },
    {
      "id": 4,
      "title": "LLM errors/sec by type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(llm_errors_total[$__rate_interval])) by (model, type)",
          "legendFormat": "{{model}} - {{type}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Requests/min",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(llm_request_duration_seconds_count[$__rate_interval])) * 60"
        }
      ]
    },
    {
      "id": 6,
      "title": "Error rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(rate(llm_errors_total[$__rate_interval])) / clamp_min(sum(rate(llm_request_duration_seconds_count[$__rate_interval])), 1e-9)"
        }
      ]
    },
    {
      "id": 8,
      "title": "vLLM concurrency (running / waiting)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Scraped straight off the vLLM server, not via the proxy - needs the SSH tunnel up and the vllm-* job UP in Prometheus (Status -> Targets). 'waiting' alone was previously flat at zero and looked broken: requests only queue once the engine is saturated, which this workload never reaches, so 'running' is added to show actual in-flight concurrency. Both are instantaneous gauges sampled every 15s, so short requests between scrapes are genuinely invisible here.",
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "vllm:num_requests_running",
          "legendFormat": "running - {{model_name}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "vllm:num_requests_waiting",
          "legendFormat": "waiting - {{model_name}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "vLLM KV-cache utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Fraction of the allocated KV cache in use (0-1). Reads near-zero by design here: the cache is sized for max-model-len (1M tokens), so ordinary requests occupy a tiny slice of it - the axis is deliberately left to autoscale rather than pinned to 0-100%, which flattened every real value onto the baseline and made it look stuck at 0. A number that stays near zero is healthy; sustained values near 1 mean the cache is the bottleneck.",
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "decimals": 4 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "comment": "vllm:kv_cache_usage_perc, NOT the older vllm:gpu_cache_usage_perc - the V1 engine renamed it, and querying the old name silently returns nothing rather than erroring.",
          "expr": "vllm:kv_cache_usage_perc",
          "legendFormat": "{{model_name}}"
        }
      ]
    }
  ]
}
