{
  "uid": "llmhell-token-usage",
  "title": "Token usage",
  "tags": [
    "llmhell"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Token throughput by kind (tok/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(llm_tokens_total{kind=~\"prompt|completion|reasoning\"}[$__rate_interval])) by (kind, model)",
          "legendFormat": "{{kind}} {{model}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Cache hit rate (% of prompt tokens)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(llm_cached_tokens_total[$__rate_interval])) by (model) / clamp_min(sum(rate(llm_tokens_total{kind=\"prompt\"}[$__rate_interval])) by (model), 1e-9)",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Median tokens per request",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum(rate(llm_tokens_per_request_bucket[$__rate_interval])) by (le, kind, model))",
          "legendFormat": "{{kind}} {{model}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "p95 tokens per request",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(llm_tokens_per_request_bucket[$__rate_interval])) by (le, kind, model))",
          "legendFormat": "{{kind}} {{model}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cache hit rate now",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(llm_cached_tokens_total[$__rate_interval])) / clamp_min(sum(rate(llm_tokens_total{kind=\"prompt\"}[$__rate_interval])), 1e-9)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Total tokens/sec",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(llm_tokens_total[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 7,
      "title": "Cached tokens/sec",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(llm_cached_tokens_total[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 11,
      "title": "Token usage by model",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "format": "table",
          "rawSql": "SELECT model, count(*) AS \"requests\", sum(tokens_prompt) AS \"prompt_tokens\", sum(tokens_completion) AS \"completion_tokens\", sum(tokens_cached) AS \"cached_tokens\", sum(tokens_reasoning) AS \"reasoning_tokens\", round(100.0 * sum(tokens_cached) / nullif(sum(tokens_prompt), 0), 2) AS \"cache_hit_pct\" FROM llm_requests GROUP BY model ORDER BY sum(tokens_prompt) DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cache_hit_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "title": "Token usage by tester",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "format": "table",
          "rawSql": "SELECT u.username, count(*) AS \"requests\", sum(l.tokens_prompt) AS \"prompt_tokens\", sum(l.tokens_completion) AS \"completion_tokens\", sum(l.tokens_cached) AS \"cached_tokens\", round(100.0 * sum(l.tokens_cached) / nullif(sum(l.tokens_prompt), 0), 2) AS \"cache_hit_pct\" FROM llm_requests l JOIN users u ON u.id = l.user_id GROUP BY u.username ORDER BY sum(l.tokens_prompt) DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cache_hit_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      }
    }
  ]
}
