# --- Postgres (application database) ---
POSTGRES_USER=llmhell
POSTGRES_PASSWORD=change_me
POSTGRES_DB=llmhell
POSTGRES_HOST=postgres
# Container-internal port (used for api -> postgres traffic *inside* the
# compose network) - always 5432, the image's fixed listen port. If you
# change the host-side mapping in docker-compose.yml's postgres `ports:`
# (e.g. to dodge a local Postgres already using 5432), edit only the
# left-hand side there; leave this value alone regardless.
POSTGRES_PORT=5432

# --- Dev / mock ---
# When true, model_endpoints are seeded on boot to point at the bundled
# mock_vllm service, so the proxy and the answer engine are exercisable
# without a GPU or a real RunPod endpoint.
USE_MOCK_VLLM=false

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change_me

# ===========================================================================
# Knowledge base
# ===========================================================================
#
# TWO FOOT-GUNS, both of which fail in confusing ways:
#
#  1. Any `list[str]` setting is parsed as JSON, not as a comma-separated
#     string. CORS_ORIGINS=http://localhost:3001 raises a validation error
#     at startup; it must be ["http://localhost:3001"].
#
#  2. KB_DATABASE_URI is libpq form and must NOT carry the "+asyncpg"
#     suffix that DATABASE_URL uses - it is handed to the postgres-mcp
#     sidecar, which is not SQLAlchemy.

# --- Web session auth ---
# Set to true whenever the app is served over TLS, or the session cookie
# travels in the clear.
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800

# JSON array. The frontend normally reaches the API through Next's rewrite
# proxy and is same-origin, so this only matters for hitting :8000 directly.
CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]

# --- Answer engine ---
# Empty means "the first enabled model endpoint". Set it to a
# ModelEndpoint.model_id to pin one.
ANSWER_MODEL_ID=
ANSWER_MAX_OUTPUT_TOKENS=1024

# --- Postgres knowledge base (searched via generated SQL) ---
# Points at the `kb` database as the read-only kb_ro role - deliberately a
# different database from DATABASE_URL, so generated SQL cannot reach the
# application's users/sessions/api_keys tables. See
# docker/postgres/initdb/01-create-kb.sql.
KB_DATABASE_URI=postgresql://kb_ro:kb_ro_password@postgres:5432/kb
# Whitelist. Generated SQL may reference nothing else, and GET /api/records
# resolves table names against this rather than trusting the URL.
KB_SEARCH_TABLES=["articles","tickets"]

# --- GitLab ---
# A CLASSIC personal access token with the `read_api` scope. A fine-grained
# token needs Metadata:Read + Projects:Read + Code:Read, and returns
# 403 insufficient_granular_scope until all three are granted.
GITLAB_PERSONAL_ACCESS_TOKEN=
# For a GitLab running on the host (not in this compose project), use
# host.docker.internal so the containers can reach it.
GITLAB_API_URL=http://host.docker.internal:32769/api/v4
GITLAB_WEB_URL=http://localhost:32769
# Instance-wide code search needs GitLab advanced search, which is
# Elasticsearch-backed and NOT available on Community Edition. On CE, list
# the projects to search here and the connector searches each one directly.
GITLAB_DEFAULT_PROJECT_IDS=[]

# --- Google Workspace ---
# "http" talks to the google-mcp sidecar; "stdio" spawns the server as a
# child of the API process (single worker only).
GOOGLE_MCP_MODE=http
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NOT optional. Every Google tool takes `email` as a REQUIRED argument -
# the server is multi-account and has no notion of a default one, so
# without this no Google call can be made at all.
GOOGLE_ACCOUNT_EMAIL=
# Drive and Gmail search return metadata only, with no body text, so an
# answer built on them would have titles to cite and nothing to quote. This
# many top hits get a second call to fetch their content. Each is a round
# trip; 0 disables it.
GOOGLE_ENRICH_HITS=3

# --- Debugging ---
# Enables POST /api/debug/mcp/call, which returns raw, unfiltered MCP
# payloads. Off by default for that reason.
ENABLE_MCP_DEBUG=false
