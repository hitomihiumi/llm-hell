# --- Postgres ---
POSTGRES_USER=llmhell
POSTGRES_PASSWORD=change_me
POSTGRES_DB=llmhell
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Dev / mock ---
# When true, model_endpoints are seeded on boot to point at the bundled
# mock_vllm service, so the proxy is exercisable without a GPU or a real
# RunPod endpoint.
USE_MOCK_VLLM=true

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change_me
