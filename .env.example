# --- Postgres ---
POSTGRES_USER=llmhell
POSTGRES_PASSWORD=change_me
POSTGRES_DB=llmhell
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# First admin account, created by the seed script on first boot
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me
SEED_ADMIN_INVITE_CODE=ADMIN-SEED

# --- Storage ---
PROJECTS_DIR=/data/projects
# Host-side path to the same directory as PROJECTS_DIR, used only when the
# worker asks the host Docker daemon (over the mounted socket) to bind-mount
# a project's workspace into a sandbox container - that daemon resolves
# paths on the host, not inside the worker container. Relative paths are
# resolved relative to this file's directory (docker-compose.yml).
PROJECTS_HOST_DIR=./data/projects
MAX_PROJECT_FILES=3000
MAX_PROJECT_TOTAL_BYTES=50000000
MAX_PROJECT_FILE_BYTES=1000000

# --- Sandbox ---
SANDBOX_IMAGE=llmhell-runner:latest
SANDBOX_CPUS=2
SANDBOX_MEM_LIMIT=2g
SANDBOX_PIDS_LIMIT=256
SANDBOX_IDLE_TIMEOUT_SECONDS=600
SANDBOX_COMMAND_TIMEOUT_SECONDS=120

# --- Run limits ---
MAX_CONCURRENT_RUNS=4
MAX_ITERATIONS_PER_RUN=25
MAX_WALL_TIME_SECONDS=1200
MAX_TOKENS_PER_RUN=400000

# --- Context ---
CONTEXT_COMPACTION_THRESHOLD=0.75

# --- Dev / mock ---
# When true, model_endpoints seeded on boot point at the bundled mock_vllm service.
USE_MOCK_VLLM=true

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change_me

